{
  "name": "@localtunnel/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "LocalTunnel \u2014 expose your home services to the internet through your own VPS.",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "start:menubar": "npm run build && electron . --menu-bar",
    "dev": "vite",
    "dist": "../../scripts/bundle-gateway.sh && npm run build && electron-builder --config.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux --x64 --arm64 && node ../../scripts/make-deb.mjs"
  },
  "dependencies": {
    "@localtunnel/agent": "1.0.0",
    "@localtunnel/protocol": "1.0.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@carbon/icons-react": "^11.86.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.3",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.localtunnel.desktop",
    "productName": "LocalTunnel",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "assets/icons/png/*.png",
      "assets/icons/tray/*.png"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../agent/dist",
        "to": "agent/dist"
      },
      {
        "from": "../../node_modules/node-forge",
        "to": "agent/node_modules/node-forge"
      },
      {
        "from": "../protocol",
        "to": "agent/node_modules/@localtunnel/protocol",
        "filter": [
          "package.json",
          "dist/**/*"
        ]
      },
      {
        "from": "../../build/localtunnel-gateway.tar.gz",
        "to": "gateway/localtunnel-gateway.tar.gz"
      },
      {
        "from": "../../installer",
        "to": "installer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/icons/png",
      "executableName": "localtunnel-desktop"
    }
  },
  "homepage": "https://github.com/ArnavCooli/LocalTunnel",
  "author": {
    "name": "ArnavCooli",
    "email": "155097185+ArnavCooli@users.noreply.github.com"
  }
}
